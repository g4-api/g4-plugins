<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Assembly -->
		<TargetFramework>net10.0</TargetFramework>
		<AssemblyVersion>10.0.0.0</AssemblyVersion>
		<FileVersion>10.0.0.0</FileVersion>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<SatelliteResourceLanguages>en-US</SatelliteResourceLanguages>
		<LangVersion>latest</LangVersion>

		<!-- Package -->
		<PackageId>G4.Plugins.SqlServer</PackageId>
		<Title>G4.Plugins.SqlServer</Title>
		<PackageProjectUrl>https://github.com/g4-api</PackageProjectUrl>
		<Authors>G4™ API Community</Authors>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
		<PackageLicenseExpression>Apache-2.0+</PackageLicenseExpression>
		<Description>The G4.Plugins.SqlServer package provides a collection of plugins for querying, scripting, importing, and collecting data with Microsoft SQL Server within the G4 automation ecosystem, built on the official Microsoft.Data.SqlClient provider.</Description>
		<PackageTags>WebDriver;Automation;Testing;RPA;G4;SqlServer;MSSQL;Database;ADO.NET</PackageTags>
		<Copyright>Copyright 2023 (c) Roei Sabag &amp; HRC Corporation. All rights reserved.</Copyright>

		<!-- https://learn.microsoft.com/en-us/dotnet/fundamentals/syslib-diagnostics/syslib1040-1049 -->
		<NoWarn>$(NoWarn);SYSLIB1045;IDE0130</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="G4.Converters" Version="2026.11.12.102" />
		<PackageReference Include="G4.Extensions" Version="2026.11.12.102" />
		<PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />

		<!-- Pin: Microsoft.Data.SqlClient 7.1.1 floors this at vulnerable 9.0.18 (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7) -->
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="*.Manifests\**\*.*" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="G4.UnitTests" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\G4.Plugins.Common\G4.Plugins.Common.csproj" />
	</ItemGroup>

</Project>
